# [환경 변수 설정 템플릿]
# 이 파일을 복사하여 .env 로 이름을 변경한 후 실제 키 값을 입력하세요.
# 주의: .env 파일은 .gitignore에 등록되어 있으므로 Git에 커밋되지 않습니다.

# OpenAI API Key (LLM / Embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (선택)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face Access Token
HUGGINGFACE_HUB_TOKEN=your_hf_token_here

# Weights & Biases (ML 실험 추적 - 선택)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=skku-ai-hackathon

# Server / App Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
