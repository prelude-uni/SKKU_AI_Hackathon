# [환경 변수 설정 템플릿]
# 이 파일을 복사하여 .env.local 로 이름을 변경한 후 실제 키 값을 입력하세요.
# 주의: .env / .env.local 파일은 .gitignore에 등록되어 있으므로 Git에 커밋되지 않습니다.

# BAZE API Gateway (Mindlogic) - Gemini, GPT, Claude 통합 게이트웨이
BAZE_API_KEY=your_baze_api_key_here
BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
AI_MODEL=gemini-3.8-flash

# OpenAI-Compatible Base URL
OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
OPENAI_API_KEY=your_baze_api_key_here

# Server / App Settings
PORT=3000
HOST=0.0.0.0
DEBUG=True
